rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read. Anyone can make or join a table (no sign-in), with size caps so nobody can dump junk in.
    match /rooms/{code} {
      allow read: if true;
      allow create: if request.resource.data.code == code
                    && request.resource.data.players is list && request.resource.data.players.size() <= 6
                    && request.resource.data.status in ['lobby', 'playing'];
      allow update: if request.resource.data.players is list && request.resource.data.players.size() <= 6;
      allow delete: if false;
      match /throws/{t} {
        allow read: if true;
        allow create: if request.resource.data.tr is string && request.resource.data.tr.size() < 20000
                      && request.resource.data.seq is int;
        allow update: if false;
        allow delete: if true;   // unrecorded games wipe their flips at the end
      }
    }
    match /tapes/{code} {
      allow read: if true;
      allow create, update: if request.resource.data.code == code;
      allow delete: if false;
    }
  }
}
