rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read. Writes need an anonymous Firebase Auth user, and only the host or
    // a seated player (uid listed in playerIds) can touch a live table.
    // Names: the page allows 14 characters; a little slack here.
    function okName(p, i) { return p.size() <= i || (p[i].name is string && p[i].name.size() <= 24); }
    function okPlayers(p) { return p is list && p.size() <= 6
      && okName(p, 0) && okName(p, 1) && okName(p, 2) && okName(p, 3) && okName(p, 4) && okName(p, 5); }
    function room(code) { return get(/databases/$(database)/documents/rooms/$(code)).data; }
    function ids(d) { return d.get('playerIds', []); }

    match /rooms/{code} {
      allow read: if true;
      allow create: if request.auth.uid != null
                    && request.resource.data.code == code
                    && request.resource.data.host == request.auth.uid
                    && okPlayers(request.resource.data.players)
                    && request.resource.data.playerIds is list
                    && (request.auth.uid in request.resource.data.playerIds)
                    && request.resource.data.status in ['lobby', 'playing']
                    && request.resource.data.goal is int && request.resource.data.goal >= 1 && request.resource.data.goal <= 10;
      // code, host and goal never change; a finished or closed table stays finished or closed;
      // only the host or someone seated (before or after this write) can touch the room
      allow update: if request.auth.uid != null
                    && okPlayers(request.resource.data.players)
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.host == resource.data.host
                    && request.resource.data.goal == resource.data.goal
                    && (!(resource.data.status in ['done', 'closed']) || request.resource.data.status == resource.data.status)
                    && (
                      request.auth.uid == resource.data.host
                      || (request.auth.uid in ids(resource.data))
                      || (request.auth.uid in ids(request.resource.data))
                    );
      allow delete: if false;
      match /throws/{t} {
        allow read: if true;
        // flips only go onto a live table, from a seated player
        allow create: if request.auth.uid != null
                      && request.resource.data.tr is string && request.resource.data.tr.size() < 20000
                      && request.resource.data.seq is int
                      && room(code).status == 'playing'
                      && (request.auth.uid in ids(room(code)));
        allow update: if false;
        // only unrecorded games wipe their flips at the end; a tape can't be erased
        allow delete: if request.auth.uid != null
                      && room(code).record == false
                      && (request.auth.uid == room(code).host || request.auth.uid in ids(room(code)));
      }
    }
    // the shelf entry for a finished, taped game; only the host of the finished table writes it
    match /tapes/{code} {
      allow read: if true;
      allow create, update: if request.auth.uid != null
                            && request.resource.data.code == code
                            && okPlayers(request.resource.data.players)
                            && room(code).status == 'done'
                            && room(code).host == request.auth.uid;
      allow delete: if false;
    }
  }
}
